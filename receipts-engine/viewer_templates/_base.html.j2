<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}Receipts Viewer{% endblock %}</title>
<style>
:root { --bg:#fbfaf7; --fg:#1d1d1b; --muted:#6b6a65; --line:#e3e1da; --card:#ffffff; --pass:#1f7a4a; --fail:#b3261e; --accent:#2d5bd3; --warn:#8a5a00; }
@media (prefers-color-scheme: dark) { :root { --bg:#151514; --fg:#ecebe6; --muted:#a3a29b; --line:#33322e; --card:#1d1d1b; --pass:#5ccf8f; --fail:#ff8a80; --accent:#8fb0ff; --warn:#f0c062; } }
* { box-sizing:border-box; }
body { margin:0; background:var(--bg); color:var(--fg); font:15px/1.5 -apple-system, "Segoe UI", Roboto, sans-serif; }
main { max-width:1200px; margin:0 auto; padding:24px 16px 64px; }
a { color:var(--accent); }
h1 { font-size:24px; margin:0 0 4px; } h2 { font-size:17px; margin:28px 0 8px; }
.muted { color:var(--muted); } .banner { background:var(--warn); color:var(--bg); padding:8px 12px; border-radius:6px; margin:8px 0 16px; font-weight:600; }
nav a { margin-right:16px; }
table { width:100%; border-collapse:collapse; background:var(--card); }
th, td { text-align:left; padding:8px 10px; border-bottom:1px solid var(--line); vertical-align:top; }
th { font-size:12px; text-transform:uppercase; letter-spacing:.04em; color:var(--muted); }
.wrap { overflow-x:auto; }
.controls { display:flex; flex-wrap:wrap; gap:8px; margin:12px 0; }
input, select { font:inherit; padding:6px 8px; border:1px solid var(--line); border-radius:6px; background:var(--card); color:var(--fg); }
.card { background:var(--card); border:1px solid var(--line); border-radius:8px; padding:14px 16px; margin:10px 0; }
.card h3 { margin:0 0 6px; font-size:15px; }
.pass { color:var(--pass); font-weight:600; } .fail { color:var(--fail); font-weight:600; }
.quote { border-left:3px solid var(--line); padding-left:10px; white-space:pre-wrap; word-break:break-word; }
pre { white-space:pre-wrap; word-break:break-word; background:var(--bg); border:1px solid var(--line); padding:10px; border-radius:6px; }
.kpis { display:flex; flex-wrap:wrap; gap:12px; } .kpi { background:var(--card); border:1px solid var(--line); border-radius:8px; padding:10px 14px; min-width:140px; }
.kpi b { display:block; font-size:22px; }
</style>
</head>
<body><main>
<nav><a href="{{ root }}index.html">Leads</a><a href="{{ root }}summary.html">Summary</a></nav>
{% if demo %}<div class="banner">DEMO: built from fixture or synthetic data, not live evidence. Not for outreach.</div>{% endif %}
{% block body %}{% endblock %}
<p class="muted">Generated {{ generated }} by Receipts Engine.</p>
</main></body></html>
